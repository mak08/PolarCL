;;; Run after loading PolarCL: (polarcl-tests:run-tests)
(defpackage :polarcl-tests (:use :cl) (:export :run-tests))
(in-package :polarcl-tests)
(defun run-tests ()
  (let ((polarcl::*servers* nil) (polarcl::*redirectors* nil)
        (polarcl::*handlers* nil) (polarcl::*exact-handlers* nil)
        (polarcl::*prefix-handlers* nil) (polarcl::*regex-handlers* nil)
        (polarcl::*registered-functions-ht* (make-hash-table :test #'equal))
        (polarcl::*authentication-providers* (make-hash-table :test #'equal))
        (polarcl::*auth-users* (make-hash-table :test #'equal))
        (polarcl::*auth-tokens* (make-hash-table :test #'equal))
        (polarcl::*digest-users* (make-hash-table :test #'equal))
        (polarcl::*digest-nonces* (make-hash-table :test #'equal)))
    (dolist (type '(polarcl:exact-filter polarcl:prefix-filter polarcl:regex-filter))
      (polarcl:register-handler :filter (polarcl:create-filter type :path "/test")
        :handler (polarcl::create-handler 'polarcl:rfunc-handler)))
    (polarcl:register-redirector :filter (polarcl:create-filter 'polarcl:exact-filter)
      :redirector (polarcl:create-redirector :path "/test"))
    (polarcl:register-function "test" :symbol #'identity)
    (setf polarcl::*servers* '(test))
    (dolist (table (list polarcl::*authentication-providers* polarcl::*auth-users*
                        polarcl::*auth-tokens* polarcl::*digest-users* polarcl::*digest-nonces*))
      (setf (gethash "test" table) t))
    (polarcl::reset)
    (assert (every #'null (list polarcl::*servers* polarcl::*redirectors* polarcl::*handlers*
                               polarcl::*exact-handlers* polarcl::*prefix-handlers* polarcl::*regex-handlers*)))
    (dolist (table (list polarcl::*authentication-providers* polarcl::*auth-users* polarcl::*auth-tokens*
                        polarcl::*digest-users* polarcl::*digest-nonces* polarcl::*registered-functions-ht*))
      (assert (zerop (hash-table-count table))))
    (polarcl::reset))
  (format t "~&PolarCL configuration reset tests passed.~%") t)
