(in-package :polarcl)

(define-condition websocket-backpressure (error) ())
(define-condition websocket-closed (error) ())

(defclass websocket-handler (handler)
  ((options :reader ws-options :initarg :options)))
(defun ws-option (handler key) (getf (ws-options handler) key))
(defun make-websocket-handler (&key authentication (format :raw) origins (allow-missing-origin nil)
                                   subprotocols require-subprotocol on-handshake on-open on-message on-close on-error
                                   (json-reader #'ws-json-read) (json-writer #'ws-json-write)
                                   (max-message-size 1048576) (max-queue-bytes 4194304)
                                   (max-queue-messages 64) (json-depth 64)
                                   (ping-interval 30) (pong-timeout 10) (close-timeout 5))
  (unless (member format '(:raw :json)) (error "WebSocket format must be :RAW or :JSON."))
  (dolist (limit (list max-message-size max-queue-bytes max-queue-messages json-depth))
    (check-type limit (integer 1)))
  (dolist (timeout (list pong-timeout close-timeout)) (check-type timeout (real (0))))
  (when ping-interval (check-type ping-interval (real (0))))
  (dolist (fn (list on-handshake on-open on-message on-close on-error json-reader json-writer))
    (unless (or (null fn) (functionp fn) (and (symbolp fn) (fboundp fn)))
      (error "Invalid WebSocket callback: ~s" fn)))
  (unless (and (listp origins) (every #'stringp origins)
               (listp subprotocols) (every #'ws-token-p subprotocols))
    (error "Origins and subprotocols must be literal lists of strings."))
  (when (and require-subprotocol (null subprotocols)) (error "Required subprotocol list is empty."))
  (make-instance 'websocket-handler :authentication authentication
    :options (list :format format :origins origins :allow-missing-origin allow-missing-origin
                   :subprotocols subprotocols :require-subprotocol require-subprotocol
                   :on-handshake on-handshake :on-open on-open :on-message on-message
                   :on-close on-close :on-error on-error :json-reader json-reader :json-writer json-writer
                   :max-message-size max-message-size :max-queue-bytes max-queue-bytes
                   :max-queue-messages max-queue-messages :json-depth json-depth
                   :ping-interval ping-interval :pong-timeout pong-timeout :close-timeout close-timeout)))

(defclass websocket ()
  ((server :reader ws-server :initarg :server)
   (handler :reader ws-handler :initarg :handler)
   (request :reader websocket-request :initarg :request)
   (connection :reader ws-connection :initarg :connection)
   (subprotocol :reader websocket-subprotocol :initarg :subprotocol)
   (data :accessor websocket-data :initform nil)
   (lock :reader ws-lock :initform (bordeaux-threads:make-lock "WebSocket"))
   (state :accessor ws-state :initform :connecting)
   (wakeup :accessor ws-wakeup :initform nil)
   (out :accessor ws-out :initform nil) (out-bytes :accessor ws-out-bytes :initform 0)
   (events :accessor ws-events :initform nil) (event-bytes :accessor ws-event-bytes :initform 0)
   (event-count :accessor ws-event-count :initform 0) (scheduled :accessor ws-scheduled :initform nil)
   (close-frame :accessor ws-close-frame :initform nil)
   (close-deadline :accessor ws-close-deadline :initform nil)
   (peer-closed :accessor ws-peer-closed :initform nil)
   (close-code :accessor ws-close-code :initform 1006) (close-reason :accessor ws-close-reason :initform "")
   (sent-close :accessor ws-sent-close :initform nil)))
(defun ws-now () (/ (get-internal-real-time) internal-time-units-per-second))
(defun websocket-principal (socket) (request-principal (websocket-request socket)))
(defun websocket-state (socket)
  (bordeaux-threads:with-lock-held ((ws-lock socket)) (ws-state socket)))
(defun ws-setting (socket key) (ws-option (ws-handler socket) key))

(defun ws-token-p (text)
  (and (stringp text) (plusp (length text))
       (every (lambda (char) (or (find char "!#$%&'*+-.^_`|~")
                                 (<= 48 (char-code char) 57) (<= 65 (char-code char) 90)
                                 (<= 97 (char-code char) 122))) text)))
(defun ws-header-values (request name)
  (mapcar #'field-value (remove-if-not (lambda (header) (string-equal name (field-name header)))
                                      (headers request))))
(defun ws-single-header (request name)
  (let ((values (ws-header-values request name)))
    (when (= (length values) 1) (first values))))
(defun ws-tokens (request name)
  (loop for value in (ws-header-values request name) append
    (mapcar (lambda (part) (string-trim '(#\Space #\Tab) part))
            (cl-utilities:split-sequence #\, value))))
(defun ws-reject (response code text)
  (setf (status-code response) code (status-text response) text
        (http-header response :|Connection|) "close" (http-body response) text)
  response)

(defmethod handle-response ((server http-server) (filter t) (handler websocket-handler)
                            (connection t) (request t) (response t))
  (block handshake
    (flet ((reject (code text) (return-from handshake (ws-reject response code text))))
      (unless (and (eq (http-method request) :get) (string= (http-version request) "HTTP/1.1")
                   (ws-single-header request "Host")
                   (member "upgrade" (ws-tokens request "Connection") :test #'string-equal)
                   (member "websocket" (ws-tokens request "Upgrade") :test #'string-equal)
                   (null (http-header request "Transfer-Encoding"))
                   (or (null (http-header request "Content-Length"))
                       (string= "0" (http-header request "Content-Length"))))
        (reject "400" "Invalid WebSocket handshake"))
      (unless (equal "13" (ws-single-header request "Sec-WebSocket-Version"))
        (setf (http-header response :|Sec-WebSocket-Version|) "13")
        (reject "426" "Upgrade Required"))
      (let ((key (ws-single-header request "Sec-WebSocket-Key"))
            (origin (ws-single-header request "Origin"))
            (offered (ws-tokens request "Sec-WebSocket-Protocol")))
        (unless (and key (cl-ppcre:scan "^[A-Za-z0-9+/]{22}==$" key)
                     (handler-case (= 16 (length (base64:base64-string-to-usb8-array key))) (error () nil)))
          (reject "400" "Invalid WebSocket key"))
        (unless (if (ws-header-values request "Origin")
                    (and origin (member origin (ws-option handler :origins) :test #'string=))
                    (ws-option handler :allow-missing-origin))
          (reject "403" "Origin not allowed"))
        (unless (and (every #'ws-token-p offered) (= (length offered) (length (remove-duplicates offered :test #'string=))))
          (reject "400" "Invalid subprotocol list"))
        (let ((protocol (find-if (lambda (name) (member name offered :test #'string=))
                                 (ws-option handler :subprotocols))))
          (when (and (ws-option handler :require-subprotocol) (null protocol))
            (reject "400" "No matching subprotocol"))
          (when (ws-option handler :on-handshake)
            (unless (funcall (ws-option handler :on-handshake) request response)
              (when (equal "200" (status-code response)) (ws-reject response "403" "Handshake rejected"))
              (setf (http-header response :|Connection|) "close")
              (return-from handshake response))
            (unless (equal "200" (status-code response)) (return-from handshake response)))
          ;; Reserve capacity before sending 101. The HTTP owner cancels on write failure.
          (let ((socket (reserve-websocket server handler connection request protocol)))
            (unless socket (reject "503" "WebSocket capacity exhausted"))
            (setf (response-upgrade response) socket)
            (setf (status-code response) "101" (status-text response) "Switching Protocols"
                  (body response) ""
                  (headers response)
                  (remove-if (lambda (header)
                               (member (field-name header)
                                       '("Connection" "Upgrade" "Sec-WebSocket-Accept" "Sec-WebSocket-Protocol"
                                         "Sec-WebSocket-Extensions" "Content-Length" "Transfer-Encoding"
                                         "Content-Encoding" "Content-Type" "Access-Control-Allow-Origin")
                                       :test #'string-equal)) (headers response)))
            (setf (http-header response :|Connection|) "Upgrade"
                  (http-header response :|Upgrade|) "websocket"
                  (http-header response :|Sec-WebSocket-Accept|)
                  (base64:usb8-array-to-base64-string
                   (mbedtls:mbedtls-md (concatenate 'string key "258EAFA5-E914-47DA-95CA-C5AB0DC85B11")
                                       :method "SHA1" :result-type :bytes)))
            (when protocol (setf (http-header response :|Sec-WebSocket-Protocol|) protocol))
            response))))))

;;; Per-server callback pool. One scheduled entry per connection, one event per turn.
(defstruct ws-pool (lock (bordeaux-threads:make-lock "WebSocket callbacks"))
                   (condition (bordeaux-threads:make-condition-variable)) queue threads stopping)
(defun ws-schedule (socket)
  ;; Called with the connection lock held. Workers release pool lock before taking it.
  (let ((pool (server-ws-pool (ws-server socket))))
    (setf (ws-scheduled socket) t)
    (bordeaux-threads:with-lock-held ((ws-pool-lock pool))
      (setf (ws-pool-queue pool) (nconc (ws-pool-queue pool) (list socket)))
      (bordeaux-threads:condition-notify (ws-pool-condition pool)))))
(defun ws-event (socket kind value &optional (bytes 0))
  (bordeaux-threads:with-lock-held ((ws-lock socket))
    (when (and (eq kind :message)
               (or (>= (ws-event-count socket) (ws-setting socket :max-queue-messages))
                   (> (+ bytes (ws-event-bytes socket)) (ws-setting socket :max-queue-bytes))))
      (ws-fail 1008 "Incoming message queue full"))
    (incf (ws-event-count socket)) (incf (ws-event-bytes socket) bytes)
    (setf (ws-events socket) (nconc (ws-events socket) (list (list kind value bytes))))
    (unless (ws-scheduled socket) (ws-schedule socket))))
(defun ws-report-error (socket condition)
  (handler-case
      (if (ws-setting socket :on-error) (funcall (ws-setting socket :on-error) socket condition)
          (log2:warning "WebSocket error: ~a" condition))
    (error (nested) (log2:warning "WebSocket error callback failed: ~a" nested))))
(defun ws-call-event (socket kind value)
  (case kind
    (:error (ws-report-error socket value))
    (:open (when (ws-setting socket :on-open) (funcall (ws-setting socket :on-open) socket)))
    (:message
     (when (eq (websocket-state socket) :open)
       (let ((message
               (if (= (car value) 1)
                   (let ((text (ws-utf8 (cdr value))))
                     (if (eq (ws-setting socket :format) :json)
                         (handler-case
                             (progn (ws-json-depth-check text (ws-setting socket :json-depth))
                                    (funcall (ws-setting socket :json-reader) text))
                           (error () (ws-fail 1007 "Invalid JSON message"))) text))
                   (if (eq (ws-setting socket :format) :json) (ws-fail 1003 "JSON endpoint requires text")
                       (cdr value)))))
         (when (ws-setting socket :on-message) (funcall (ws-setting socket :on-message) socket message)))))
    (:close (when (ws-setting socket :on-close) (apply (ws-setting socket :on-close) socket value)))))
(defun ws-callback-worker (server pool)
  (declare (ignore server))
  (loop
    (let ((socket
            (bordeaux-threads:with-lock-held ((ws-pool-lock pool))
              (loop while (null (ws-pool-queue pool)) do
                (when (ws-pool-stopping pool) (return-from ws-callback-worker nil))
                (bordeaux-threads:condition-wait (ws-pool-condition pool) (ws-pool-lock pool) :timeout 0.2))
              (pop (ws-pool-queue pool)))))
      (let ((event (bordeaux-threads:with-lock-held ((ws-lock socket)) (pop (ws-events socket)))))
        (unwind-protect
             (handler-case (ws-call-event socket (first event) (second event))
               (error (condition)
                 (ws-report-error socket condition)
                 (unless (eq (first event) :close)
                   (websocket-close socket :code (if (typep condition 'websocket-protocol-error)
                                                    (ws-error-code condition) 1011)
                                           :reason "Callback or message failure"))))
          (bordeaux-threads:with-lock-held ((ws-lock socket))
            (decf (ws-event-count socket)) (decf (ws-event-bytes socket) (third event))
            (if (ws-events socket) (ws-schedule socket) (setf (ws-scheduled socket) nil)))
          (when (eq (first event) :close)
            (bordeaux-threads:with-lock-held ((server-ws-lock (ws-server socket)))
              (setf (server-ws-retiring (ws-server socket))
                    (delete socket (server-ws-retiring (ws-server socket)))))))))))

(defun reserve-websocket (server handler connection request protocol)
  (bordeaux-threads:with-lock-held ((server-ws-lock server))
    (unless (and (server-running server) (< (+ (length (server-websockets server)) (length (server-ws-retiring server))) (server-websocket-limit server)))
      (return-from reserve-websocket nil))
    (when (and (server-ws-pool server) (ws-pool-stopping (server-ws-pool server)))
      (setf (server-ws-pool server) nil))
    (unless (server-ws-pool server)
      (let ((pool (make-ws-pool)))
        (check-type (server-websocket-workers server) (integer 1))
        (setf (server-ws-pool server) pool)
        (setf (ws-pool-threads pool)
              (loop repeat (server-websocket-workers server) collect
                (bordeaux-threads:make-thread (lambda () (ws-callback-worker server pool)) :name "WebSocket callback")))))
    (let ((socket (make-instance 'websocket :server server :handler handler :connection connection
                                 :request request :subprotocol protocol)))
      (setf (ws-wakeup socket) (mbedtls:make-io-wakeup))
      (push socket (server-websockets server)) socket)))
(defun cancel-websocket (socket)
  ;; Before transfer, the HTTP worker still owns the underlying connection.
  (bordeaux-threads:with-lock-held ((ws-lock socket))
    (setf (ws-state socket) :closed)
    (when (ws-wakeup socket) (mbedtls:close-io-wakeup (ws-wakeup socket)) (setf (ws-wakeup socket) nil)))
  (bordeaux-threads:with-lock-held ((server-ws-lock (ws-server socket)))
    (setf (server-websockets (ws-server socket)) (delete socket (server-websockets (ws-server socket))))))

(defun ws-queue-frame (socket opcode payload)
  (when (> (length payload) (ws-setting socket :max-message-size)) (error "Outgoing WebSocket message too large."))
  (let ((frame (ws-frame opcode payload)))
    (bordeaux-threads:with-lock-held ((ws-lock socket))
      (unless (eq (ws-state socket) :open) (error 'websocket-closed))
      (when (or (>= (length (ws-out socket)) (ws-setting socket :max-queue-messages))
                (> (+ (length frame) (ws-out-bytes socket)) (ws-setting socket :max-queue-bytes)))
        (error 'websocket-backpressure))
      (setf (ws-out socket) (nconc (ws-out socket) (list frame)))
      (incf (ws-out-bytes socket) (length frame))
      (mbedtls:signal-io-wakeup (ws-wakeup socket))))
  t)
(defun websocket-send-text (socket text)
  (unless (eq (ws-setting socket :format) :raw) (error "Use WEBSOCKET-SEND on JSON endpoints."))
  (ws-queue-frame socket 1 (ws-text text)))
(defun websocket-send-binary (socket bytes)
  (unless (eq (ws-setting socket :format) :raw) (error "Use WEBSOCKET-SEND on JSON endpoints."))
  (check-type bytes (vector (unsigned-byte 8)))
  (ws-queue-frame socket 2 bytes))
(defun websocket-send (socket value)
  (if (eq (ws-setting socket :format) :json)
      (let ((text (funcall (ws-setting socket :json-writer) value)))
        (check-type text string)
        (ws-json-depth-check text (ws-setting socket :json-depth))
        (ws-queue-frame socket 1 (ws-text text)))
      (etypecase value (string (websocket-send-text socket value))
                       ((vector (unsigned-byte 8)) (websocket-send-binary socket value)))))
(defun websocket-close (socket &key (code 1000) (reason ""))
  (let ((frame (ws-frame 8 (ws-close-payload code reason))))
    (bordeaux-threads:with-lock-held ((ws-lock socket))
      (when (member (ws-state socket) '(:open :connecting))
        (setf (ws-state socket) :closing (ws-close-frame socket) frame
              (ws-close-deadline socket) (+ (ws-now) (ws-setting socket :close-timeout))
              (ws-out socket) nil (ws-out-bytes socket) 0)
        (mbedtls:signal-io-wakeup (ws-wakeup socket)))))
  nil)

(defun stop-websockets (server)
  (let ((sockets (bordeaux-threads:with-lock-held ((server-ws-lock server)) (copy-list (server-websockets server)))))
    (dolist (socket sockets) (websocket-close socket :code 1001 :reason "Server stopping"))))
(defun wait-websockets (server)
  ;; Connection I/O owners have finite close deadlines. Never destroy shared TLS
  ;; configuration while they still use it; callbacks may outlive their transport.
  (loop while (bordeaux-threads:with-lock-held ((server-ws-lock server)) (server-websockets server)) do (sleep 0.02))
  (when (server-ws-pool server)
    (bordeaux-threads:with-lock-held ((ws-pool-lock (server-ws-pool server)))
      (setf (ws-pool-stopping (server-ws-pool server)) t))))
(defun start-websocket (socket)
  (mbedtls:enable-nonblocking (ws-connection socket))
  (bordeaux-threads:make-thread (lambda () (run-websocket socket)) :name "WebSocket I/O"))

(defun run-websocket (socket)
  (let ((connection (ws-connection socket))
        (decoder (make-ws-decoder :max-size (ws-setting socket :max-message-size)))
        (input (ws-bytes 16384)) (out nil) (offset 0) (pending nil) (out-close nil)
        (controls nil) (read-want :want-read) (write-want :want-write)
        (last-ping (ws-now)) (ping-token nil) (ping-deadline nil) (serial 0) (failed nil))
    (labels ((control (opcode payload)
               (when (> (length controls) 16) (ws-fail 1008 "Control queue full"))
               (setf controls (nconc controls (list (ws-frame opcode payload)))))
             (receive (opcode payload)
               (case opcode
                 ((1 2)
                  (when (eq (websocket-state socket) :open)
                    ;; Validate text independently of application decoding.
                    (when (= opcode 1) (ws-utf8 payload))
                    (ws-event socket :message (cons opcode payload) (length payload))))
                 (8
                  (multiple-value-bind (code reason) (ws-decode-close payload)
                    (bordeaux-threads:with-lock-held ((ws-lock socket))
                      (setf (ws-peer-closed socket) t (ws-close-code socket) code (ws-close-reason socket) reason))
                    (websocket-close socket :code (if (= code 1005) 1000 code) :reason reason)))
                 (9 (unless (ws-sent-close socket) (control 10 payload)))
                 (10 (when (and ping-token (equalp ping-token payload))
                       (setf ping-token nil ping-deadline nil))))))
      (unwind-protect
           (handler-case
               (progn
                 (bordeaux-threads:with-lock-held ((ws-lock socket))
                   (when (eq (ws-state socket) :connecting) (setf (ws-state socket) :open)))
                 (ws-event socket :open nil)
                 (loop
                   (unless (server-running (ws-server socket)) (websocket-close socket :code 1001 :reason "Server stopping"))
                   (let ((now (ws-now)))
                     (when (and (ws-close-deadline socket) (>= now (ws-close-deadline socket))) (return))
                     (when (and (ws-peer-closed socket) (ws-sent-close socket)) (return))
                     (when (and ping-deadline (>= now ping-deadline))
                       (websocket-close socket :code 1001 :reason "Pong timeout"))
                     (when (and (eq (websocket-state socket) :open) (ws-setting socket :ping-interval)
                                (null ping-token) (>= (- now last-ping) (ws-setting socket :ping-interval)))
                       (setf ping-token (ws-text (write-to-string (incf serial))) last-ping now
                             ping-deadline (+ now (ws-setting socket :pong-timeout)))
                       (control 9 ping-token)))
                   (unless out
                     (bordeaux-threads:with-lock-held ((ws-lock socket))
                       (cond ((ws-close-frame socket)
                              (setf out (ws-close-frame socket) (ws-close-frame socket) nil out-close t controls nil))
                             ((and controls (eq (ws-state socket) :open)) (setf out (pop controls)))
                             ((and (ws-out socket) (eq (ws-state socket) :open))
                              (setf out (pop (ws-out socket))) (decf (ws-out-bytes socket) (length out))))))
                   ;; A TLS read requiring writability must resume before a write.
                   (when (and out (not (eq read-want :want-write)))
                     (multiple-value-bind (count status)
                         (if pending (mbedtls:write-nonblocking connection)
                             (mbedtls:write-nonblocking connection out :start offset))
                       (incf offset count) (setf pending (member status '(:want-read :want-write)) write-want status)
                       (when (= offset (length out))
                         (when out-close (setf (ws-sent-close socket) t))
                         (setf out nil offset 0 out-close nil))))
                   (unless (or pending failed)
                     (multiple-value-bind (count status) (mbedtls:read-nonblocking connection input)
                       (setf read-want (if (eq status :want-write) :want-write :want-read))
                       (case status
                         (:ok
                          (handler-case (ws-feed decoder input #'receive count)
                            (websocket-protocol-error (condition)
                              (setf failed t) (ws-event socket :error condition)
                              (websocket-close socket :code (ws-error-code condition) :reason (ws-error-reason condition)))))
                         ((:eof :peer-closed) (return)))))
                   (when (and failed (ws-sent-close socket)) (return))
                   ;; Return to the loop on producer wakeups. A short upper bound also
                   ;; services heartbeat/shutdown deadlines when no socket event occurs.
                   (mbedtls:wait-for-io connection
                     (cond (pending write-want) ((eq read-want :want-write) :want-write)
                           (out :want-write) (t :want-read))
                     :timeout-ms (if (or pending (eq read-want :want-write)) 50
                                     (if (or out controls (ws-out socket)) 0 50)) :wakeup (ws-wakeup socket))))
             (error (condition) (ws-event socket :error condition)))
        (bordeaux-threads:with-lock-held ((ws-lock socket))
          (setf (ws-state socket) :closed (ws-out socket) nil (ws-out-bytes socket) 0)
          (mbedtls:close-io-wakeup (ws-wakeup socket)) (setf (ws-wakeup socket) nil))
        (let ((clean (and (ws-peer-closed socket) (ws-sent-close socket))))
          ;; TLS close-notify is best effort with a bounded deadline after WS close.
          (when clean
            (ignore-errors
              (loop with until = (+ (ws-now) 0.2)
                    for status = (mbedtls:shutdown-nonblocking connection)
                    until (or (eq status :ok) (>= (ws-now) until))
                    do (mbedtls:wait-for-io connection status :timeout-ms 20))))
          (handler-case (mbedtls:deallocate connection)
            (error (condition) (ws-event socket :error condition)))
          (bordeaux-threads:with-lock-held ((server-ws-lock (ws-server socket)))
            ;; Keep capacity charged until on-close finishes, bounding callback
            ;; memory even when peers rapidly connect/disconnect behind slow callbacks.
            (push socket (server-ws-retiring (ws-server socket)))
            (setf (server-websockets (ws-server socket)) (delete socket (server-websockets (ws-server socket))))
            (ws-event socket :close (list (ws-close-code socket) (ws-close-reason socket) clean))))))))
