(in-package :polarcl)

(define-condition websocket-protocol-error (error)
  ((code :reader ws-error-code :initarg :code)
   (reason :reader ws-error-reason :initarg :reason))
  (:report (lambda (condition stream) (write-string (ws-error-reason condition) stream))))
(defun ws-fail (code reason) (error 'websocket-protocol-error :code code :reason reason))
(defun ws-bytes (&optional (size 0)) (make-array size :element-type '(unsigned-byte 8)))
(defun ws-utf8 (bytes)
  (handler-case (babel:octets-to-string bytes :encoding :utf-8 :errorp t)
    (error () (ws-fail 1007 "Invalid UTF-8"))))
(defun ws-text (text) (babel:string-to-octets text :encoding :utf-8 :errorp t))
(defun ws-valid-close-code-p (code)
  (or (member code '(1000 1001 1002 1003 1007 1008 1009 1010 1011 1012 1013 1014))
      (<= 3000 code 4999)))
(defun ws-close-payload (code reason)
  (unless (and (integerp code) (ws-valid-close-code-p code)) (error "Invalid WebSocket close code."))
  (let* ((bytes (ws-text reason)) (payload (ws-bytes (+ 2 (length bytes)))))
    (when (> (length bytes) 123) (error "Close reason exceeds 123 UTF-8 bytes."))
    (setf (aref payload 0) (ldb (byte 8 8) code) (aref payload 1) (ldb (byte 8 0) code))
    (replace payload bytes :start1 2) payload))
(defun ws-decode-close (payload)
  (when (= (length payload) 1) (ws-fail 1002 "Invalid close payload"))
  (if (zerop (length payload)) (values 1005 "")
      (let ((code (+ (* 256 (aref payload 0)) (aref payload 1))))
        (unless (ws-valid-close-code-p code) (ws-fail 1002 "Invalid close code"))
        (values code (ws-utf8 (subseq payload 2))))))

(defun ws-frame (opcode payload &optional (final t))
  "Encode an unmasked server frame. PAYLOAD is already octets."
  (let* ((size (length payload)) (extra (cond ((< size 126) 0) ((< size 65536) 2) (t 8)))
         (out (ws-bytes (+ 2 extra size))))
    (setf (aref out 0) (logior (if final 128 0) opcode)
          (aref out 1) (case extra (0 size) (2 126) (8 127)))
    (dotimes (i extra) (setf (aref out (+ 2 i)) (ldb (byte 8 (* 8 (- extra i 1))) size)))
    (replace out payload :start1 (+ 2 extra)) out))

(defstruct ws-decoder
  (header (ws-bytes 14)) (header-count 0) (header-needed 2)
  payload (payload-count 0) opcode final mask
  fragment-opcode (fragments nil) (message-size 0) (fragment-count 0)
  (utf-left 0) (utf-min 128) (utf-max 191)
  (max-size 1048576))

(defun ws-check-utf8-byte (decoder byte)
  (if (plusp (ws-decoder-utf-left decoder))
      (progn
        (unless (<= (ws-decoder-utf-min decoder) byte (ws-decoder-utf-max decoder))
          (ws-fail 1007 "Invalid UTF-8 continuation"))
        (decf (ws-decoder-utf-left decoder))
        (setf (ws-decoder-utf-min decoder) 128 (ws-decoder-utf-max decoder) 191))
      (cond ((< byte 128))
            ((<= 194 byte 223) (setf (ws-decoder-utf-left decoder) 1))
            ((<= 224 byte 239)
             (setf (ws-decoder-utf-left decoder) 2
                   (ws-decoder-utf-min decoder) (if (= byte 224) 160 128)
                   (ws-decoder-utf-max decoder) (if (= byte 237) 159 191)))
            ((<= 240 byte 244)
             (setf (ws-decoder-utf-left decoder) 3
                   (ws-decoder-utf-min decoder) (if (= byte 240) 144 128)
                   (ws-decoder-utf-max decoder) (if (= byte 244) 143 191)))
            (t (ws-fail 1007 "Invalid UTF-8 leading byte")))))

(defun ws-header-ready (decoder)
  (let* ((header (ws-decoder-header decoder)) (first (aref header 0))
         (second (aref header 1)) (opcode (logand first 15))
         (marker (logand second 127)) (extra (case marker (126 2) (127 8) (t 0))))
    (unless (and (zerop (logand first 112)) (logbitp 7 second)
                 (member opcode '(0 1 2 8 9 10)))
      (ws-fail 1002 "Invalid frame header or missing client mask"))
    (when (and (>= opcode 8) (or (not (logbitp 7 first)) (> marker 125)))
      (ws-fail 1002 "Invalid control frame"))
    (setf (ws-decoder-header-needed decoder) (+ 6 extra))
    (when (< (ws-decoder-header-count decoder) (+ 6 extra)) (return-from ws-header-ready nil))
    (let ((size (if (zerop extra) marker
                    (loop for i below extra for value = (aref header 2)
                          then (+ (* value 256) (aref header (+ 2 i))) finally (return value)))))
      (when (or (and (= extra 2) (< size 126)) (and (= extra 8) (< size 65536))
                (>= size (expt 2 63)))
        (ws-fail 1002 "Noncanonical frame length"))
      (when (< opcode 8)
        (when (if (= opcode 0) (null (ws-decoder-fragment-opcode decoder))
                  (ws-decoder-fragment-opcode decoder))
          (ws-fail 1002 "Invalid continuation sequence"))
        (when (> (+ size (ws-decoder-message-size decoder)) (ws-decoder-max-size decoder))
          (ws-fail 1009 "Message exceeds configured limit")))
      (setf (ws-decoder-opcode decoder) opcode (ws-decoder-final decoder) (logbitp 7 first)
            (ws-decoder-mask decoder) (subseq header (+ 2 extra) (+ 6 extra))
            (ws-decoder-payload decoder) (ws-bytes size) (ws-decoder-payload-count decoder) 0)
      t)))

(defun ws-complete-frame (decoder emit)
  (let ((opcode (ws-decoder-opcode decoder)) (payload (ws-decoder-payload decoder)))
    (cond ((>= opcode 8) (funcall emit opcode payload))
          (t
           (when (> (incf (ws-decoder-fragment-count decoder)) 1024)
             (ws-fail 1009 "Too many message fragments"))
           (unless (= opcode 0) (setf (ws-decoder-fragment-opcode decoder) opcode))
           (incf (ws-decoder-message-size decoder) (length payload))
           (push payload (ws-decoder-fragments decoder))
           (when (ws-decoder-final decoder)
             (when (plusp (ws-decoder-utf-left decoder)) (ws-fail 1007 "Incomplete UTF-8 message"))
             (let ((message (ws-bytes (ws-decoder-message-size decoder))) (offset 0))
               (dolist (part (reverse (ws-decoder-fragments decoder)))
                 (replace message part :start1 offset) (incf offset (length part)))
               (funcall emit (ws-decoder-fragment-opcode decoder) message))
             (setf (ws-decoder-fragment-opcode decoder) nil (ws-decoder-fragments decoder) nil
                   (ws-decoder-message-size decoder) 0 (ws-decoder-fragment-count decoder) 0))))
    (setf (ws-decoder-payload decoder) nil (ws-decoder-header-count decoder) 0
          (ws-decoder-header-needed decoder) 2)))

(defun ws-feed (decoder bytes emit &optional (end (length bytes)))
  "Consume arbitrary transport chunks. EMIT receives complete messages/control frames."
  (loop for i below end do
    (if (ws-decoder-payload decoder)
        (let ((pos (ws-decoder-payload-count decoder)))
          (setf (aref (ws-decoder-payload decoder) pos)
                (logxor (aref bytes i) (aref (ws-decoder-mask decoder) (mod pos 4))))
          (when (or (= (ws-decoder-opcode decoder) 1)
                    (and (= (ws-decoder-opcode decoder) 0) (eql (ws-decoder-fragment-opcode decoder) 1)))
            (ws-check-utf8-byte decoder (aref (ws-decoder-payload decoder) pos)))
          (incf (ws-decoder-payload-count decoder)))
        (progn
          (setf (aref (ws-decoder-header decoder) (ws-decoder-header-count decoder)) (aref bytes i))
          (incf (ws-decoder-header-count decoder))
          (when (= (ws-decoder-header-count decoder) (ws-decoder-header-needed decoder))
            (ws-header-ready decoder))))
    (when (and (ws-decoder-payload decoder)
               (= (ws-decoder-payload-count decoder) (length (ws-decoder-payload decoder))))
      (ws-complete-frame decoder emit))))
