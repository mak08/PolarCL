;;; HTTP authentication; authorization and identity-provider workflows are external.
(in-package :polarcl)

(defstruct principal id source attributes)
(defstruct authentication-context principal scheme)
(defstruct (credentials (:print-object (lambda (object stream)
                                        (declare (ignore object))
                                        (write-string "#<CREDENTIALS>" stream))))
  username password token)
(defstruct authentication-result status principal digest-ha1)
(defun authentication-success (principal &key digest-ha1)
  (check-type principal principal)
  (unless (and (principal-id principal) (principal-source principal))
    (error "Principal requires an ID and identity source"))
  (make-authentication-result :status :success :principal principal :digest-ha1 digest-ha1))
(defun authentication-rejected () (make-authentication-result :status :rejected))
(defun request-principal (request)
  (when (request-authentication request)
    (authentication-context-principal (request-authentication request))))

(defvar *authentication-lock* (bordeaux-threads:make-lock "authentication registries"))
(defvar *authentication-providers* (make-hash-table :test #'equal))
(defvar *auth-users* (make-hash-table :test #'equal))
(defvar *auth-tokens* (make-hash-table :test #'equal))
(defvar *digest-users* (make-hash-table :test #'equal))
(defvar *digest-nonces* (make-hash-table :test #'equal))
(defstruct (authentication-policy (:constructor %make-authentication-policy)) scheme realm provider (require-tls t) (nonce-lifetime 300))
(defstruct digest-nonce policy expires (counts (make-hash-table :test #'equal)))

(defun reset-authentication ()
  (bordeaux-threads:with-lock-held (*authentication-lock*)
    (dolist (table (list *authentication-providers* *auth-users* *auth-tokens*
                        *digest-users* *digest-nonces*))
      (clrhash table))))

(defun register-authentication-provider (name scheme function)
  "FUNCTION receives (policy request credentials) and returns an authentication result.
Digest success must also supply :digest-ha1; PolarCL verifies the proof itself."
  (assert (member scheme '(:basic :bearer :digest)))
  (assert (functionp function))
  (when (member name '(:local-users :local-tokens :local-digest))
    (error "Reserved provider name"))
  (bordeaux-threads:with-lock-held (*authentication-lock*)
    (setf (gethash (list scheme name) *authentication-providers*) function))
  name)

(defun auth-random-bytes (count)
  ;; PolarCL's supported server environment is Unix/SBCL. Do not use CL:RANDOM
  ;; for credentials, salts or nonces.
  (let ((bytes (make-array count :element-type '(unsigned-byte 8))))
    (with-open-file (stream #P"/dev/urandom" :element-type '(unsigned-byte 8))
      (unless (= count (read-sequence bytes stream)) (error "Random source failed")))
    bytes))
(defun auth-hex (bytes)
  (string-downcase (format nil "~{~2,'0x~}" (coerce bytes 'list))))
(defun auth-sha256 (text)
  ;; Use the stateless native API with byte pointers, not cl-mbedtls's shared
  ;; context/string wrapper (which also counts characters instead of bytes).
  (let ((bytes (babel:string-to-octets text :encoding :utf-8)))
    (cffi:with-pointer-to-vector-data (input bytes)
      (cffi:with-foreign-object (output :unsigned-char 32)
        (unless (zerop (cffi:foreign-funcall "mbedtls_md"
                         :pointer (mbedtls::mbedtls-md-info-from-string "SHA256")
                         :pointer input :size (length bytes) :pointer output :int))
          (error "SHA-256 failed"))
        (auth-hex (loop for i below 32 collect (cffi:mem-aref output :unsigned-char i)))))))
(defun auth-password-hash (password salt iterations)
  (let ((bytes (babel:string-to-octets password :encoding :utf-8)))
    (cffi:with-pointer-to-vector-data (input bytes)
      (cffi:with-pointer-to-vector-data (salt-pointer salt)
        (cffi:with-foreign-object (output :unsigned-char 32)
          (unless (zerop (cffi:foreign-funcall "mbedtls_pkcs5_pbkdf2_hmac_ext"
                           :int (cffi:foreign-funcall "mbedtls_md_get_type"
                                  :pointer (mbedtls::mbedtls-md-info-from-string "SHA256") :int)
                           :pointer input :size (length bytes)
                           :pointer salt-pointer :size (length salt)
                           :unsigned-int iterations :uint32 32 :pointer output :int))
            (error "PBKDF2 failed"))
          (auth-hex (loop for i below 32 collect (cffi:mem-aref output :unsigned-char i))))))))
(defun auth-equal (a b)
  "Compare fixed-size hash strings without an early exit on differing characters."
  (and (stringp a) (stringp b) (= (length a) (length b))
       (zerop (loop for x across a for y across b
                   for difference = (logxor (char-code x) (char-code y))
                   sum difference))))
(defun auth-nfc (string)
  #+sbcl (sb-unicode:normalize-string string :nfc)
  #-sbcl (error "Authentication Unicode normalization requires SBCL"))
(defun auth-control-p (string)
  (some (lambda (c) (or (< (char-code c) 32) (= (char-code c) 127))) string))

(defun register-user (name realm password &key (provider :local-users) principal)
  "Register a Basic credential. Store a salted PBKDF2-HMAC-SHA256 verifier only."
  (let* ((name (auth-nfc name)) (password (auth-nfc password))
         (salt (auth-random-bytes 16)) (iterations 600000))
    (when (or (find #\: name) (auth-control-p name) (auth-control-p password))
      (error "Invalid Basic credentials"))
    (let ((entry (list salt iterations (auth-password-hash password salt iterations)
                       (or principal (make-principal :id name :source provider)))))
      (check-type (fourth entry) principal)
      (bordeaux-threads:with-lock-held (*authentication-lock*)
        (setf (gethash (list provider realm name) *auth-users*) entry))))
  name)
(defun register-token (token principal &key (provider :local-tokens) realm expires)
  "Register an opaque bearer token. EXPIRES is universal time; NIL means no expiry."
  (check-type principal principal)
  (unless (cl-ppcre:scan "^[A-Za-z0-9._~+/-]+=*$" token) (error "Invalid bearer token syntax"))
  (when expires (check-type expires integer))
  (bordeaux-threads:with-lock-held (*authentication-lock*)
    (setf (gethash (list provider realm (auth-sha256 token)) *auth-tokens*)
          (list principal expires)))
  principal)
(defun revoke-token (token &key (provider :local-tokens) realm)
  (bordeaux-threads:with-lock-held (*authentication-lock*)
    (remhash (list provider realm (auth-sha256 token)) *auth-tokens*)))
(defun register-digest-user (name realm &key password ha1 (provider :local-digest) principal)
  "Supply PASSWORD or its SHA-256 H(username:realm:password), never both."
  (unless (and (not (eq (null password) (null ha1))) (stringp name) (stringp realm))
    (error "Supply exactly one Digest password or HA1"))
  (let* ((name (auth-nfc name))
         (hash (or ha1 (auth-sha256 (format nil "~a:~a:~a" name realm (auth-nfc password)))))
         (principal (or principal (make-principal :id name :source provider))))
    (check-type principal principal)
    (unless (cl-ppcre:scan "^[0-9a-fA-F]{64}$" hash) (error "Invalid SHA-256 HA1"))
    (bordeaux-threads:with-lock-held (*authentication-lock*)
      (setf (gethash (list provider realm name) *digest-users*)
            (list (string-downcase hash) principal))))
  name)

(defun local-authentication-provider (policy request credentials)
  (declare (ignore request))
  (let* ((provider (authentication-policy-provider policy))
         (realm (authentication-policy-realm policy))
         (scheme (authentication-policy-scheme policy))
         (entry (bordeaux-threads:with-lock-held (*authentication-lock*)
                  (ecase scheme
                    (:basic (gethash (list provider realm (credentials-username credentials)) *auth-users*))
                    (:digest (gethash (list provider realm (credentials-username credentials)) *digest-users*))
                    (:bearer (gethash (list provider realm (auth-sha256 (credentials-token credentials))) *auth-tokens*))))))
    (ecase scheme
      (:basic
       ;; A missing account still incurs the password derivation work.
       (let ((hash (auth-password-hash (credentials-password credentials)
                                      (if entry (first entry) (make-array 16 :element-type '(unsigned-byte 8) :initial-element 0))
                                      (if entry (second entry) 600000))))
         (if (and entry (auth-equal hash (third entry)))
             (authentication-success (fourth entry)) (authentication-rejected))))
      (:bearer
       (if (and entry (or (null (second entry)) (> (second entry) (get-universal-time))))
           (authentication-success (first entry)) (authentication-rejected)))
      (:digest
       (if entry (authentication-success (second entry) :digest-ha1 (first entry))
           (authentication-rejected))))))

(defun auth-provider (policy)
  (let ((name (authentication-policy-provider policy))
        (scheme (authentication-policy-scheme policy)))
    (if (eq name (ecase scheme (:basic :local-users) (:bearer :local-tokens) (:digest :local-digest)))
        #'local-authentication-provider
        (or (bordeaux-threads:with-lock-held (*authentication-lock*)
              (gethash (list scheme name) *authentication-providers*))
            (error "Unknown authentication provider for ~a" scheme)))))
(defun make-authentication-policy (scheme &key realm provider (require-tls t) (nonce-lifetime 300))
  (unless (member scheme '(:basic :bearer :digest)) (error "Unsupported authentication scheme"))
  (unless (and (stringp realm) (plusp (length realm))
               (every (lambda (c) (<= 32 (char-code c) 126)) realm))
    (error "Authentication requires a nonempty ASCII realm"))
  (unless (member require-tls '(nil t)) (error "Invalid TLS policy"))
  (when (and (eq scheme :bearer) (not require-tls)) (error "Bearer requires TLS"))
  (unless (and (integerp nonce-lifetime) (<= 1 nonce-lifetime 3600)) (error "Invalid nonce lifetime"))
  (let ((policy (%make-authentication-policy :scheme scheme :realm realm
                  :provider (or provider (ecase scheme (:basic :local-users) (:bearer :local-tokens) (:digest :local-digest)))
                  :require-tls require-tls :nonce-lifetime nonce-lifetime)))
    (auth-provider policy)
    policy))

(defun auth-quoted (string)
  (with-output-to-string (s)
    (write-char #\" s)
    (loop for c across string do
      (when (find c '(#\" #\\)) (write-char #\\ s)) (write-char c s))
    (write-char #\" s)))
(defun issue-digest-nonce (policy)
  (let ((nonce (auth-hex (auth-random-bytes 32))) (now (get-universal-time)))
    (bordeaux-threads:with-lock-held (*authentication-lock*)
      ;; Retain recently expired entries to distinguish stale from forged nonces.
      (maphash (lambda (key value)
                 (when (< (+ 300 (digest-nonce-expires value)) now)
                   (remhash key *digest-nonces*))) *digest-nonces*)
      (when (>= (hash-table-count *digest-nonces*) 4096)
        (error "Digest nonce capacity exceeded"))
      (setf (gethash nonce *digest-nonces*)
            (make-digest-nonce :policy policy :expires (+ now (authentication-policy-nonce-lifetime policy)))))
    nonce))
(defun authentication-challenges (policy &key error-code stale)
  ;; A list intentionally supports multiple WWW-Authenticate fields later.
  (list
   (let ((realm (auth-quoted (authentication-policy-realm policy))))
     (ecase (authentication-policy-scheme policy)
       (:basic (format nil "Basic realm=~a, charset=~s" realm "UTF-8"))
       (:bearer (format nil "Bearer realm=~a~@[~a~]" realm
                        (when error-code (format nil ", error=~a" (auth-quoted error-code)))))
       (:digest (format nil "Digest realm=~a, nonce=~a, algorithm=SHA-256, qop=~s, charset=~s~a"
                        realm (auth-quoted (issue-digest-nonce policy)) "auth" "UTF-8"
                        (if stale ", stale=true" "")))))))
(defun authentication-failure (policy request &key (status "401") error-code stale)
  (let ((response (make-http-response :request request :status-code status
                   :status-text (if (equal status "400") "Bad Request" "Unauthorized")
                   :headers (list (make-instance 'http-header :name :|Connection| :value "close")))))
    (dolist (challenge (authentication-challenges policy :error-code error-code :stale stale))
      (push (make-instance 'http-header :name :|WWW-Authenticate| :value challenge) (headers response)))
    (setf (http-body response) "")
    response))

(define-condition malformed-credentials (error) ())
(defun malformed-credentials () (error 'malformed-credentials))
(defun parse-basic-credentials (value)
  (unless (cl-ppcre:scan "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" value)
    (malformed-credentials))
  (let* ((decoded (handler-case
                     (babel:octets-to-string (base64:base64-string-to-usb8-array value) :encoding :utf-8)
                   (error () (malformed-credentials))))
         (colon (position #\: decoded)))
    (unless (and colon (not (auth-control-p decoded))) (malformed-credentials))
    (make-credentials :username (auth-nfc (subseq decoded 0 colon))
                      :password (auth-nfc (subseq decoded (1+ colon))))))
(defun parse-digest-parameters (text)
  ;; HTTP auth-param grammar: quoted commas/escapes, case-insensitive names,
  ;; no duplicate parameters, no Lisp reader, no silent trailing garbage.
  (let ((i 0) (n (length text)) (result (make-hash-table :test #'equalp)))
    (labels ((ows () (loop while (and (< i n) (find (char text i) '(#\Space #\Tab))) do (incf i)))
             (token-char-p (c) (or (find c "!#$%&'*+-.^_`|~")
                                   (and (<= 48 (char-code c) 57))
                                   (and (<= 65 (char-code c) 90))
                                   (and (<= 97 (char-code c) 122))))
             (token () (let ((start i))
                         (loop while (and (< i n) (token-char-p (char text i))) do (incf i))
                         (when (= start i) (malformed-credentials)) (subseq text start i)))
             (value ()
               (if (and (< i n) (char= (char text i) #\"))
                   (progn (incf i)
                     (with-output-to-string (s)
                       (loop
                         (when (>= i n) (malformed-credentials))
                         (let ((c (char text i)))
                           (incf i)
                           (when (char= c #\") (return))
                           (when (char= c #\\)
                             (when (>= i n) (malformed-credentials))
                             (setf c (char text i)) (incf i))
                           (when (or (< (char-code c) 32) (= (char-code c) 127)) (malformed-credentials))
                           (write-char c s)))))
                   (token))))
      (loop
        (ows)
        (let ((name (token)))
          (ows) (unless (and (< i n) (char= (char text i) #\=)) (malformed-credentials))
          (incf i) (ows)
          (when (gethash name result) (malformed-credentials))
          (setf (gethash name result) (value)))
        (ows) (when (= i n) (return result))
        (unless (char= (char text i) #\,) (malformed-credentials)) (incf i)))))

(defun digest-username (parameters)
  (let ((plain (gethash "username" parameters))
        (extended (gethash "username*" parameters)))
    (when (or (and plain extended) (not (or plain extended))) (malformed-credentials))
    (let ((name
            (handler-case
                (if extended
                    (let* ((first (position #\' extended))
                           (second (and first (position #\' extended :start (1+ first))))
                           (bytes (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0)))
                      (unless (and second (string-equal "UTF-8" (subseq extended 0 first)))
                        (malformed-credentials))
                      (loop for i from (1+ second) below (length extended) do
                        (let ((c (char extended i)))
                          (if (char= c #\%)
                              (progn
                                (unless (and (< (+ i 2) (length extended))
                                             (digit-char-p (char extended (1+ i)) 16)
                                             (digit-char-p (char extended (+ i 2)) 16))
                                  (malformed-credentials))
                                (vector-push-extend (parse-integer extended :start (1+ i) :end (+ i 3) :radix 16) bytes)
                                (incf i 2))
                              (progn (unless (< (char-code c) 128) (malformed-credentials))
                                     (vector-push-extend (char-code c) bytes)))))
                      (babel:octets-to-string bytes :encoding :utf-8))
                    ;; cl-mbedtls's header reader maps each wire octet to a char.
                    (babel:octets-to-string (map '(vector (unsigned-byte 8)) #'char-code plain) :encoding :utf-8))
              (error () (malformed-credentials)))))
      (when (or (auth-control-p name) (find #\: name)) (malformed-credentials))
      (auth-nfc name))))

(defun call-authentication-provider (policy request credentials)
  (let ((result (funcall (auth-provider policy) policy request credentials)))
    (unless (and (authentication-result-p result)
                 (member (authentication-result-status result) '(:success :rejected)))
      (error "Provider must return an authentication result"))
    result))
(defun verify-digest (policy request parameters)
  (flet ((p (key) (gethash key parameters)))
    (unless (and (every (lambda (key) (p key)) '("username" "realm" "nonce" "uri" "response" "algorithm" "qop" "nc" "cnonce"))
                 (equal (p "realm") (authentication-policy-realm policy))
                 (equalp (p "algorithm") "SHA-256") (equal (p "qop") "auth")
                 (plusp (length (p "cnonce")))
                 (cl-ppcre:scan "^[0-9a-fA-F]{8}$" (p "nc"))
                 (cl-ppcre:scan "^[0-9a-fA-F]{64}$" (p "response"))
                 (not (equalp (p "userhash") "true")))
      (return-from verify-digest (values (authentication-rejected) nil)))
    (let* ((nonce (bordeaux-threads:with-lock-held (*authentication-lock*) (gethash (p "nonce") *digest-nonces*)))
           (nc (parse-integer (p "nc") :radix 16)))
      (unless (and nonce (eq policy (digest-nonce-policy nonce)) (plusp nc))
        (return-from verify-digest (values (authentication-rejected) nil)))
      (let* ((result (call-authentication-provider policy request (make-credentials :username (auth-nfc (p "username")))))
             (ha1 (authentication-result-digest-ha1 result)))
        (unless (eq :success (authentication-result-status result)) (return-from verify-digest result))
        (unless (and (stringp ha1) (cl-ppcre:scan "^[0-9a-fA-F]{64}$" ha1))
          (error "Digest provider must supply a SHA-256 HA1"))
        (let ((expected (auth-sha256
                         (format nil "~a:~a:~a:~a:auth:~a" (string-downcase ha1) (p "nonce") (p "nc") (p "cnonce")
                                 (auth-sha256 (format nil "~a:~a" (string-upcase (symbol-name (http-method request))) (p "uri")))))))
          (unless (auth-equal expected (string-downcase (p "response")))
            (return-from verify-digest (authentication-rejected))))
        (bordeaux-threads:with-lock-held (*authentication-lock*)
          (when (<= (digest-nonce-expires nonce) (get-universal-time))
            (return-from verify-digest (values (authentication-rejected) t)))
          (let ((key (list (p "username") (p "cnonce"))))
            (unless (and (eq nonce (gethash (p "nonce") *digest-nonces*))
                         (> nc (gethash key (digest-nonce-counts nonce) 0))
                         (< (hash-table-count (digest-nonce-counts nonce)) 4096))
              (return-from verify-digest (authentication-rejected)))
            (setf (gethash key (digest-nonce-counts nonce)) nc)))
        result))))

(defun authenticate-request (policy request)
  "Return NIL to proceed or an HTTP response to stop dispatch. Never authorize."
  (setf (request-authentication request) nil)
  (unless policy (return-from authenticate-request nil))
  (when (and (authentication-policy-require-tls policy)
             (not (eq (http-protocol request) :https)))
    (return-from authenticate-request
      (make-error-response request :status-code "403" :status-text "Forbidden" :body "TLS required")))
  (let* ((scheme (authentication-policy-scheme policy))
         (fields (remove-if-not (lambda (header) (string-equal (field-name header) "Authorization")) (headers request)))
         (header (when fields (field-value (first fields)))))
    (labels ((failure (&key malformed invalid stale)
               (authentication-failure policy request
                 :status (if malformed "400" "401") :stale stale
                 :error-code (when (eq scheme :bearer) (cond (malformed "invalid_request") (invalid "invalid_token"))))))
      (unless header (return-from authenticate-request (failure)))
      (when (or (> (length fields) 1) (> (length header) 8192)
                (some (lambda (c) (or (and (< (char-code c) 32) (not (char= c #\Tab)))
                                       (= (char-code c) 127))) header))
        (return-from authenticate-request (failure :malformed t)))
      (let ((space (position #\Space header)))
        (unless space (return-from authenticate-request (failure :malformed t)))
        (unless (string-equal (subseq header 0 space) (symbol-name scheme))
          (return-from authenticate-request (failure)))
        (let* ((value (string-left-trim " " (subseq header (1+ space))))
               ;; Catch parsing failures ONLY here. User hook errors propagate to
               ;; normal 500 handling, even if they signal the same condition.
               (credentials (handler-case
                                (ecase scheme
                                  (:basic (parse-basic-credentials value))
                                  (:bearer
                                   (unless (cl-ppcre:scan "^[A-Za-z0-9._~+/-]+=*$" value) (malformed-credentials))
                                   (make-credentials :token value))
                                  (:digest
                                   (let ((parameters (parse-digest-parameters value)))
                                     (setf (gethash "username" parameters) (digest-username parameters))
                                     (unless (equal (gethash "uri" parameters) (request-target request))
                                       (malformed-credentials))
                                     parameters)))
                              (malformed-credentials ()
                                (return-from authenticate-request (failure :malformed t))))))
          (multiple-value-bind (result stale)
              (if (eq scheme :digest) (verify-digest policy request credentials)
                  (call-authentication-provider policy request credentials))
            (if (eq :success (authentication-result-status result))
                (progn
                  (check-type (authentication-result-principal result) principal)
                  (setf (request-authentication request)
                        (make-authentication-context :principal (authentication-result-principal result) :scheme scheme))
                  nil)
                (failure :invalid t :stale stale))))))))
